{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Sources": {
      "payments": "change-me-payments-secret",
      "courier": "change-me-courier-secret"
    },
    "Subscribers": [
      {
        "Name": "orders-service",
        "Url": "http://localhost:5200/webhooks",
        "Secret": "change-me-orders-secret",
        "EventTypes": [ "payment.*", "shipment.delivered" ]
      },
      {
        "Name": "audit-log",
        "Url": "http://localhost:5300/ingest",
        "Secret": "change-me-audit-secret",
        "EventTypes": []
      }
    ]
  }
}
